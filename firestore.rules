// Reglas de Firestore para Págate-IA (contrato v1, ver docs/ARQUITECTURA.md)
//
// Principios:
// - Todo dato de usuario cuelga de users/{uid}; solo el dueño accede.
// - Los agregados (months), el chat (conversations/messages), la cuota (meta)
//   y la waitlist los escribe únicamente el backend (Admin SDK, que no pasa
//   por estas reglas). Desde el cliente son solo lectura o sin acceso.
// - Denegar por defecto: todo lo que no coincide con un match explícito se rechaza.

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Helpers ----------

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function incoming() {
      return request.resource.data;
    }

    function isStr(v, max) {
      return v is string && v.size() <= max;
    }

    function isNonEmptyStr(v, max) {
      return v is string && v.size() > 0 && v.size() <= max;
    }

    function isNullableStr(d, field, max) {
      return !(field in d) || d[field] == null || isStr(d[field], max);
    }

    function isNonNegNumber(v) {
      return v is number && v >= 0;
    }

    function isPositiveNumber(v) {
      return v is number && v > 0;
    }

    function isNonNegInt(v) {
      return v is int && v >= 0;
    }

    function isTs(v) {
      return v is timestamp;
    }

    function hasTimestamps(d) {
      return isTs(d.createdAt) && isTs(d.updatedAt);
    }

    // ---------- users/{uid} ----------

    function validHourlyRate(r) {
      return r is map
        && r.keys().hasOnly(['desiredMonthlySalary', 'availableHoursPerMonth', 'hourlyValue'])
        && (!('desiredMonthlySalary' in r) || isNonNegNumber(r.desiredMonthlySalary))
        && (!('availableHoursPerMonth' in r) || isNonNegNumber(r.availableHoursPerMonth))
        && (!('hourlyValue' in r) || isNonNegNumber(r.hourlyValue));
    }

    function validProfile(d) {
      return d.keys().hasOnly([
          'name', 'businessName', 'businessType', 'currency', 'monthlyGoal',
          'avatarInitials', 'plan', 'hourlyRate', 'createdAt', 'updatedAt'
        ])
        && d.keys().hasAll(['name', 'currency', 'createdAt', 'updatedAt'])
        && isNonEmptyStr(d.name, 200)
        && (!('businessName' in d) || isStr(d.businessName, 200))
        && (!('businessType' in d) || isStr(d.businessType, 200))
        && isNonEmptyStr(d.currency, 10)
        && (!('monthlyGoal' in d) || isNonNegNumber(d.monthlyGoal))
        && (!('avatarInitials' in d) || isStr(d.avatarInitials, 10))
        && (!('hourlyRate' in d) || d.hourlyRate == null || validHourlyRate(d.hourlyRate))
        && (!('plan' in d) || d.plan in ['free', 'pro'])
        && hasTimestamps(d);
    }

    // `plan` solo lo escribe el backend: en create no puede venir; en update
    // puede omitirse o repetir exactamente el valor que ya tenía.
    function planUntouchedOnCreate(d) {
      return !('plan' in d);
    }

    function planUntouchedOnUpdate(d, prev) {
      return !('plan' in d) || ('plan' in prev && d.plan == prev.plan);
    }

    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid) && validProfile(incoming()) && planUntouchedOnCreate(incoming());
      allow update: if isOwner(uid) && validProfile(incoming()) && planUntouchedOnUpdate(incoming(), resource.data);
      allow delete: if isOwner(uid);

      // ---------- inventory ----------

      function validInventoryItem(d) {
        return d.keys().hasOnly([
            'name', 'type', 'price', 'stock', 'minStock', 'unit', 'supplier', 'code',
            'createdAt', 'updatedAt'
          ])
          && d.keys().hasAll(['name', 'type', 'price', 'stock', 'minStock', 'unit', 'createdAt', 'updatedAt'])
          && isNonEmptyStr(d.name, 200)
          && d.type in ['product', 'material']
          && isNonNegNumber(d.price)
          && isNonNegInt(d.stock)
          && isNonNegInt(d.minStock)
          && isStr(d.unit, 200)
          && isNullableStr(d, 'supplier', 200)
          && isNullableStr(d, 'code', 200)
          && hasTimestamps(d);
      }

      match /inventory/{itemId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && validInventoryItem(incoming());
      }

      // ---------- transactions ----------

      function validTransaction(d) {
        return d.keys().hasOnly([
            'title', 'description', 'amount', 'type', 'category', 'date', 'monthKey',
            'createdAt', 'updatedAt'
          ])
          && d.keys().hasAll(['title', 'amount', 'type', 'category', 'date', 'monthKey', 'createdAt', 'updatedAt'])
          && isNonEmptyStr(d.title, 200)
          && (!('description' in d) || isStr(d.description, 2000))
          && isPositiveNumber(d.amount)
          && d.type in ['income', 'expense']
          && isStr(d.category, 200)
          && isTs(d.date)
          && d.monthKey is string
          && d.monthKey.matches('^[0-9]{4}-[0-9]{2}$')
          && hasTimestamps(d);
      }

      match /transactions/{txId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && validTransaction(incoming());
      }

      // ---------- fixedExpenses ----------

      function validFixedExpense(d) {
        return d.keys().hasOnly(['name', 'amount', 'createdAt', 'updatedAt'])
          && d.keys().hasAll(['name', 'amount', 'createdAt', 'updatedAt'])
          && isNonEmptyStr(d.name, 200)
          && isPositiveNumber(d.amount)
          && hasTimestamps(d);
      }

      match /fixedExpenses/{expenseId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && validFixedExpense(incoming());
      }

      // ---------- Solo lectura (escribe el backend) ----------

      match /months/{monthKey} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      match /conversations/{convId} {
        allow read: if isOwner(uid);
        allow write: if false;

        match /messages/{msgId} {
          allow read: if isOwner(uid);
          allow write: if false;
        }
      }

      match /meta/{docId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }
    }

    // ---------- waitlist: sin acceso desde el cliente ----------

    match /waitlist/{id} {
      allow read, write: if false;
    }

    // ---------- Todo lo demás: denegado ----------

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
