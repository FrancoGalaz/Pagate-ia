migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Landing page (uses npm, not pnpm)
**/pnpm-lock.yaml

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
/android/build/

# Secretos y configuración local
.mcp.json
*.env
.env.*
!*.env.example
# landing/.env.production solo contiene la URL pública de la función waitlist
# (no es un secreto); se versiona para que el build de landing-page/ la incluya.
!landing/.env.production
landing/.env
landing/.env.local
landing/.npmrc
functions/.npmrc

# Cloud Functions (los parámetros no secretos de functions/.env sí se versionan;
# los secretos van a Secret Manager o a functions/.secret.local)
functions/node_modules/
functions/lib/
functions/.secret.local
!functions/.env
!functions/.env.local.example

# Firebase CLI / emuladores
.firebase/
firebase-debug.log
firestore-debug.log
ui-debug.log
