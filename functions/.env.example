# Parámetros de Cloud Functions (no secretos). Los secretos van a Secret Manager.
# ENFORCE_APP_CHECK: pasar a `true` cuando App Check esté registrado en la consola
# de Firebase (tarea S1-04). Mientras sea `false`, `chat` no exige token de App Check.
ENFORCE_APP_CHECK=false
OPENROUTER_MODEL=deepseek/deepseek-v4-flash
