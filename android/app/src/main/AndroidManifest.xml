<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ================== Permisos que la app SÍ usa ==================
         Se declaran aquí explícitamente aunque las AAR de Firebase ya los
         aportan por fusión de manifiestos. Dejarlos implícitos significa que la
         superficie de permisos del APK depende de qué versión de qué SDK
         resuelva Gradle ese día; declararlos hace que `aapt2 dump permissions`
         sobre el AAB sea una lista revisable y no un efecto colateral. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- ========= Permisos que llegan arrastrados y se eliminan =========
         Ninguno corresponde a una función de la app: Págate no envía ni recibe
         notificaciones push. La ficha de Google Play muestra los permisos al
         usuario, así que pedir mensajería que no existe es ruido que resta
         instalaciones y que además hay que justificar en la revisión.

         Origen exacto de cada uno, leído del informe del fusionador
         (build/app/outputs/logs/manifest-merger-release-report.txt):
         - WAKE_LOCK y c2dm.permission.RECEIVE los añade
           com.google.firebase:firebase-iid, que entra como dependencia
           transitiva de firebase_auth. Su código solo despierta el dispositivo
           si hay FCM registrado, y aquí no hay ninguna dependencia de
           Cloud Messaging.
         - READ_GSERVICES lo añade com.google.android.recaptcha, que entra por
           firebase_auth / firebase_app_check. Lo usa el flujo de reCAPTCHA de
           verificación por SMS; esta app solo autentica con correo y
           contraseña, nunca con teléfono.

         `tools:node="remove"` necesita que el permiso esté nombrado aquí para
         poder tacharlo del manifiesto fusionado; no es una declaración de uso.
         Verificado sobre el APK de release con:
           build-tools/36.1.0/aapt2.exe dump permissions <apk>
         que devuelve exactamente tres entradas: INTERNET,
         ACCESS_NETWORK_STATE y
         com.pagate.apppagate.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION.

         Esa tercera no se declara aquí ni se quita: la añade
         androidx.core:core:1.13.1 (línea 749 del informe del fusionador) para
         sus propios BroadcastReceiver registrados en tiempo de ejecución. El
         mismo manifiesto fusionado la define con
         android:protectionLevel="signature" y con el applicationId de esta
         app, así que solo se la concede la propia app: no sale en la ficha de
         Play ni se le pide nada al usuario. Queda anotada para que la próxima
         auditoría no la confunda con un permiso colado. -->
    <uses-permission android:name="android.permission.WAKE_LOCK"
        tools:node="remove" />
    <uses-permission android:name="com.google.android.c2dm.permission.RECEIVE"
        tools:node="remove" />
    <uses-permission android:name="com.google.android.providers.gsf.permission.READ_GSERVICES"
        tools:node="remove" />

    <!-- `android:label` apunta a res/values/strings.xml en vez de llevar el
         texto escrito aquí: ese archivo explica por qué el nombre visible es
         «Págate-IA» con tilde y qué otros archivos del proyecto lo fijan. -->
    <application
        android:label="@string/app_name"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
