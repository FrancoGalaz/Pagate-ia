<?xml version="1.0" encoding="utf-8"?>
<!--
  Icono adaptativo (Android 8+). Sustituye al PNG legacy, que el lanzador
  recortaba dentro de una máscara añadiéndole un marco blanco.

  Tres capas:
  - background: color plano de marca.
  - foreground: el monograma, en su propio lienzo de 108 dp para que el lanzador
    pueda animar las capas por separado.
  - monochrome: silueta para los iconos tematizados de Android 13+. Reutiliza el
    mismo vector a propósito: el sistema descarta el color de relleno y aplica su
    propia tinta, de modo que un archivo aparte solo duplicaría el trazado.

  El PNG legacy de mipmap-*dpi sigue existiendo para API 24 y 25, que no leen
  este archivo.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>
